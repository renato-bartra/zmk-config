#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  BSPC  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |  LBKT  |
// | LSHFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |  ;    |  QUOT  |
// | LCTRL |  Z  |  X  |  C   |  V   |  B   |  NUBS |  | MINS  |  N   |  M    |  ,    |  .   |   /   |  RET   |
//                     | LGUI | LALT | LOWER|  SPACE |  | SPACE | RCTRL| RAISE | RALT  |
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                  &kp N6 &kp N7   &kp N8   &kp N9   &kp N0   &kp BSPC
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T                   &kp Y  &kp U    &kp I    &kp O    &kp P    &kp LBKT
&kp LSHFT &kp A  &kp S  &kp D  &kp F  &kp G                   &kp H  &kp J    &kp K    &kp L    &kp SEMI &kp SQT
&kp LCTRL &kp Z  &kp X  &kp C  &kp V  &kp B  &kp NUBS &kp MINUS &kp N &kp M    &kp COMMA &kp DOT &kp FSLH &kp RET
                    &kp LGUI &kp LALT &mo 1  &kp SPACE  &kp SPACE  &kp RCTRL &mo 2  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |  DEL  |
// |       |     |     |      |      |      |                   | PGUP | HOME  |  UP   | END  |   +   |       |
// |       |     |     |      |      |      |                   | PGDN | LEFT  | DOWN  | RIGHT|   -   |   \   |
// |       |     |     |      |      |      |  GRAVE|  | EQUAL |      |       |   *   |      |       |       |
//                     |      |      |      |        |  |       |      |       |       |      |
            bindings = <
&trans   &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE          &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE &kp DEL
&trans   &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE          &kp PG_UP &kp HOME &kp UP   &kp END   &kp KP_PLUS &kp RBKT
&trans   &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE          &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp KP_MINUS &kp BSLH
&trans   &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE  &kp GRAVE &kp EQUAL &kp NONE &kp NONE &kp NONE &kp NONE &kp KP_ASTERISK &kp NONE
                       &trans  &trans  &trans   &trans   &trans   &trans   &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
// ------------------------------------------------------------------------------------------------------------
// |       | F1  | F2  |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |       |     | PLAY| VOL- | VOL+ | MUTE |                   |N.LCK |   1   |   2   |   3  | PRINT |  F12  |
// |       |     |     |      |      |      |                   |      |   4   |   5   |   6  |       |       |
// |       |     |     |      |      |BT_NXT|        |  |      |  8   |   9   |   0   |      |       |       |
//                     |      |      |      |        |  |       |      |       |       |      |
            bindings = <
&kp NONE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5                   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans   &kp NONE &kp C_PP &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &kp KP_NLCK &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp PRINTSCREEN &kp F12
&trans   &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE          &kp NONE &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp NONE &kp NONE
&trans   &kp NONE &kp NONE &kp NONE &kp NONE &bt BT_NXT &kp NONE &kp NONE &kp KP_N8 &kp KP_N9 &kp KP_N0 &kp NONE &kp NONE &kp NONE
                       &trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

//         /*
//          * adjust_layer - QMK layer 3 (unreachable, no MO(3)/TG(3)/LT(3) trigger)
//          * Preserved as a commented-out layer per request.
//          *
//          * To enable:
//          *   1. Add `#include <dt-bindings/zmk/rgb.h>` near the top of this file.
//          *   2. Add `#define KC_MSEL_EQUIV (ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0x0083))`
//          *      above the keymap node.
//          *   3. Uncomment the block below.
//          *   4. Add a layer-3 trigger on a visible layer (e.g. `&mo 3`).
//          *
//          * Position layout (58 keys):
//          *   row 0  z=0..5   | z=6..11
//          *   row 1  z=12..17 | z=18..23
//          *   row 2  z=24..29 | z=30..35
//          *   row 3  z=36..41 | z=42..43 inner thumbs | z=44..49
//          *   row 4  z=50..53 | z=54..57
//          */
// /*
//         adjust_layer {
//             bindings = <
// &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE          &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE
// &rgb_ug RGB_TOG 0 &rgb_ug RGB_HUI 0 &rgb_ug RGB_SAI 0 &rgb_ug RGB_BRI 0 &kp NONE &kp NONE
//                                                                   &kp NONE &kp NONE &kp SYS_WAKE &kp SYS_SLEEP &kp SYS_PWR &kp NONE
// &rgb_ug RGB_EFF 0 &rgb_ug RGB_HUD 0 &rgb_ug RGB_SAD 0 &rgb_ug RGB_BRD 0 &kp NONE &kp NONE
//                                                                   &kp NONE &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp LS(LC(ESC))
// &trans   &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE &kp NONE
//                                                                   &kp C_VOL_DN &kp KC_MSEL_EQUIV &kp C_VOL_UP &kp NONE &kp LC(LS(LG(B))) &kp NONE
//                        &trans &trans &trans &trans &trans &trans &trans &trans
//             >;
// 
//             sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
//         };
// */
    };
};
